--- /dev/null
+++ b/native/waw-remote-agent/stray_darwin.go
@@ -0,0 +1,29 @@
+//go:build darwin
+
+package main
+
+import (
+	"os"
+	"os/exec"
+	"syscall"
+	"time"
+)
+
+// killStrayRemoteAgents：macOS 无 /proc，通过 ps 扫描同一 binary 的非 daemon 进程并回收。
+func killStrayRemoteAgents(self string) {
+	out, err := exec.Command("/bin/ps", "-axo", "pid=,command=").Output()
+	if err != nil {
+		return
+	}
+	for _, pid := range findStrayPIDsFromPS(string(out), self, os.Getpid()) {
+		p, err := os.FindProcess(pid)
+		if err != nil {
+			continue
+		}
+		_ = p.Signal(syscall.SIGTERM)
+		go func(p *os.Process) {
+			time.Sleep(2 * time.Second)
+			_ = p.Kill()
+		}(p)
+	}
+}
diff --git a/native/waw-remote-agent/stray_linux.go b/native/waw-remote-agent/stray_linux.go
new file mode 100644
index 0000000..3521069
--- /dev/null
+++ b/native/waw-remote-agent/stray_linux.go
@@ -0,0 +1,54 @@
+//go:build linux
+
+package main
+
+import (
+	"os"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+)
+
+// killStrayRemoteAgents：Linux 下扫描 /proc，杀掉同一 binary 的所有非 daemon 进程。
+func killStrayRemoteAgents(self string) {
+	entries, err := os.ReadDir("/proc")
+	if err != nil {
+		return
+	}
+	realSelf := realPath(self)
+	for _, entry := range entries {
+		pid, err := strconv.Atoi(entry.Name())
+		if err != nil || pid == os.Getpid() {
+			continue
+		}
+		exe, err := os.Readlink("/proc/" + entry.Name() + "/exe")
+		if err != nil || (exe != self && realPath(exe) != realSelf) {
+			continue
+		}
+		raw, err := os.ReadFile("/proc/" + entry.Name() + "/cmdline")
+		if err != nil {
+			continue
+		}
+		isDaemon := false
+		for _, arg := range strings.Split(string(raw), "\x00") {
+			if arg == "--daemon" {
+				isDaemon = true
+				break
+			}
+		}
+		// 守护进程常驻负责唤醒；其余（worker / stdio / 遗留进程）都回收。
+		if isDaemon {
+			continue
+		}
+		p, err := os.FindProcess(pid)
+		if err != nil {
+			continue
+		}
+		_ = p.Signal(syscall.SIGTERM)
+		go func(p *os.Process) {
+			time.Sleep(2 * time.Second)
+			_ = p.Kill()
+		}(p)
+	}
+}
